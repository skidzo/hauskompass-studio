{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/building-element.schema.json",
  "title": "BuildingElement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "description", "location", "geometryRef", "status", "linkedAssetIds", "evidenceIds", "sourceIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^building://[a-z0-9][a-z0-9-]*/element/[a-z0-9][a-z0-9-]*$" },
    "type": {
      "type": "string",
      "enum": ["roof", "roof_surface", "wall", "facade", "opening", "window", "door", "beam", "room", "basement", "greenhouse", "terrain", "foundation", "technical_zone", "pv_zone", "insulation_zone", "temporary_support", "drainage", "service"]
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "location": { "type": "string" },
    "geometryRef": { "type": "string" },
    "ifcGuid": { "type": "string" },
    "parentId": { "type": "string" },
    "status": { "type": "string", "enum": ["existing", "planned", "retained", "demolished", "temporary", "unknown"] },
    "linkedAssetIds": { "type": "array", "items": { "type": "string" } },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "sourceIds": { "type": "array", "items": { "type": "string" } },
    "assumptionIds": { "type": "array", "items": { "type": "string" } },
    "reuse": { "type": "object" },
    "confidence": { "type": "string", "enum": ["confirmed", "high", "medium", "low", "unknown"] }
  }
}
