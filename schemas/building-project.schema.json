{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/building-project.schema.json",
  "title": "BuildingProject",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "locationPrivacyMode", "coordinateReferenceSystem", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^project://[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "locationPrivacyMode": { "type": "string", "enum": ["private-local-only", "approximate-public-region", "fictional-placeholder"] },
    "coordinateReferenceSystem": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
